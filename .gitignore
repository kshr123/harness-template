# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# uv
# (uv.lock はコミットする＝再現性)

# 環境・秘密（シークレット隔離：エージェントに渡さない）
.env
secrets/

# ツールキャッシュ
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# ローカル上書き設定（個人モード：追跡しない）
configs/config.local.yaml

# STATUS.md は生成物：その都度 `uv run status` で作り直す・追跡しない
STATUS.md

# データ実体・マニフェスト（正本は config の保存先URI。コミットしない）
data/**/*.parquet
data/**/*.manifest.yaml
data/**/*.tmp
data/cache/
# 保存したモデル（学習済み Pipeline の pickle と manifest・昇格記録）は実体なのでコミットしない。
# 再現の材料（seed・指紋・設定）は results/ に記録して結ぶ。
data/**/models/
mlruns/
mlflow.db
